DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LINUX_HOST=127.0.0.1
LINUX_PORT=22
LINUX_USERNAME=deploy
LINUX_PASSWORD=

DEPLOY_PROJECT_DIR=/opt/deployed-app
