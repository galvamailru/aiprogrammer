DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LINUX_HOST=127.0.0.1
LINUX_PORT=22
LINUX_USERNAME=deploy
LINUX_PASSWORD=

DEPLOY_PROJECT_DIR=/opt/deployed-app
# After compose, the model proposes SSH verification commands from the approved architecture (see config architect_system_prompt).
DEPLOY_VERIFY_MAX_COMMANDS=15
DEPLOY_VERIFY_SSH_TIMEOUT_SEC=300

# Fix-only pipeline (/api/runs/fix-only): max files in one plan iteration.
# FIX_ONLY_MAX_PLAN_FILES=12

LOCAL_PROJECT_DIR=/app/target_project
LOCAL_GIT_BRANCH=main
AUTO_GIT_PUSH=false
AUTO_DEPLOY=true
MAX_FIX_ATTEMPTS=3
GIT_AUTHOR_NAME=AI Programmer Bot
GIT_AUTHOR_EMAIL=bot@example.com
GITHUB_USERNAME=galvamailru
GITHUB_TOKEN=

APP_HOST=0.0.0.0
APP_PORT=8080
